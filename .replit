modules = ["nodejs-24"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Invisible-Text-WebApp/artifacts/invisible-webapp && PORT=5000 pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd Invisible-Text-WebApp/artifacts/api-server && pnpm run start"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[userenv]

[userenv.shared]
ADMIN_USERNAME = "admin"
ADMIN_EMAIL = "mr.sakhawat100@gmail.com"

[userenv.production]
ALLOWED_ORIGINS = "https://textsinvisible.com,https://www.textsinvisible.com"

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd Invisible-Text-WebApp/artifacts/api-server && node --enable-source-maps ./dist/index.mjs"]
build = ["bash", "-c", "cd Invisible-Text-WebApp/artifacts/invisible-webapp && pnpm run build && mkdir -p ../api-server/public && cp -r dist/public/. ../api-server/public/ && cd ../api-server && pnpm run build"]
